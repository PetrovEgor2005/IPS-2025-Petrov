def solve(params):
    a = float(params["a"])
    b = float(params["b"])
    c = float(params["c"])
    d = float(params["d"])
    mode = params["mode"]
    t = float(params.get("t", 0.0))

    denom = b + d
    if mode == "none":
        p = (a - c) / denom
    elif mode == "tax":
        p = (a - c + d * t) / denom
    else:
        p = (a - c - d * t) / denom

    q = a - b * p
    return {"p_eq": p, "q_eq": q}
