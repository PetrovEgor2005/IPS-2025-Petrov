# Скопировать в .env.prod на сервере и подставить реальные значения

# База
POSTGRES_USER=marketlab
POSTGRES_PASSWORD=REPLACE-WITH-A-LONG-RANDOM-STRING
POSTGRES_DB=marketlab
DATABASE_URL=postgresql+psycopg://marketlab:REPLACE-WITH-A-LONG-RANDOM-STRING@db:5432/marketlab

# Секрет для подписи JWT. Сгенерировать:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=REPLACE-WITH-A-LONG-RANDOM-STRING

# В production стартап упадёт, если SECRET_KEY не заменён
ENVIRONMENT=production

# Сколько судей разрешено одновременно
MAX_CONCURRENT_JUDGES=4

# Список доменов через запятую — для CORS
CORS_ORIGINS=https://marketlab.example.com

# Домен, на котором поднимается сайт
DOMAIN=marketlab.example.com

# Какой конфиг nginx использовать. Для первой выдачи сертификата —
# nginx.bootstrap.conf, потом переключить на nginx.prod.conf
NGINX_CONF_FILE=./frontend/nginx.prod.conf
